{
  "name": "shapes",
  "description": "Polytope quaternion renderer",
  "version": "0.0.0",
  "author": "Nate Goldman <ungoldman@gmail.com>",
  "bugs": {
    "url": "https://github.com/ungoldman/shapes/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "fast-check": "^4.10.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://ungoldman.com/shapes",
  "license": "CC0-1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ungoldman/shapes.git"
  },
  "scripts": {
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='src/start.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.js",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "node src/start.js",
    "test": "npm run lint && node --test test/*.test.js"
  },
  "type": "module"
}
